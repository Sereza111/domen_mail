# Порт сервера
PORT=3000

# IMAP настройки почтового сервера
IMAP_HOST=imap.beget.com
IMAP_PORT=993
IMAP_TLS=true

# SMTP Beget для отправки писем
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true

# 64 hex-символа. Сохраните ключ: без него очередь нельзя прочитать после перезапуска.
# SCHEDULE_ENCRYPTION_KEY=
# SCHEDULE_DB_PATH=./scheduled.db

# Синхронизация факта входа с генератором (не хранит пароль ящика)
GENERATOR_ACTIVITY_URL=http://host.docker.internal:3002/api/mailbox-activity
GENERATOR_ACTIVITY_TOKEN=замените-на-тот-же-токен-что-в-генераторе
